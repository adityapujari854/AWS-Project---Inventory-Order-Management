# Disposable single-instance SQLite demonstration only; do not use as production configuration.
APP_NAME=InventoryHub
ENVIRONMENT=development
DATABASE_URL=sqlite:////opt/inventoryhub/data/inventory.db
LOG_LEVEL=INFO
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_MAX_AGE_SECONDS=28800
# HTTP-only Stage A demonstration. Set true only after HTTPS is configured.
SESSION_COOKIE_SECURE=false
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
S3_PRODUCT_IMAGE_PREFIX=product-images
S3_PRESIGNED_URL_TTL_SECONDS=900
S3_MAX_IMAGE_SIZE_BYTES=5242880
