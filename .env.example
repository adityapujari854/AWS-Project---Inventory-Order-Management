# Local development uses SQLite by default. For MySQL/RDS, provide a full SQLAlchemy URL.
DATABASE_URL=sqlite:///./inventory.db
APP_NAME=InventoryHub
ENVIRONMENT=development
LOG_LEVEL=INFO
# Use a long, random value in production; do not commit the real secret.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_MAX_AGE_SECONDS=28800
# Set true when HTTPS is terminated at the application or trusted proxy.
SESSION_COOKIE_SECURE=false
# Used only once by the local bootstrap script; never commit actual credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional private S3 product-image storage. Leave bucket/region unset to disable image operations locally.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
S3_PRODUCT_IMAGE_PREFIX=product-images
S3_PRESIGNED_URL_TTL_SECONDS=900
S3_MAX_IMAGE_SIZE_BYTES=5242880

